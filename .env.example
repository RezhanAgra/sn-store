APP_NAME="SN Store"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Ganti ke mysql jika memakai MySQL (lalu isi DB_* di bawah)
DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database.sqlite (opsional, default database/database.sqlite)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=sn_store
# DB_USERNAME=root
# DB_PASSWORD=

BCRYPT_ROUNDS=12

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

MIDTRANS_MERCHANT_ID=
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

RAJAONGKIR_API_KEY=
# Asal pengiriman: ID kelurahan Makassar di RajaOngkir
RAJAONGKIR_ORIGIN_ID=79234
